# 复制为 backend/.env，仅在服务器本地填写密码，不提交 Git。
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my-order-test
DB_USER=my-order-test
DB_PASSWORD=
SESSION_SECRET=
# 改为浏览器实际访问的地址，包含 http/https 和非默认端口，不加末尾斜杠。
PUBLIC_BASE_URL=http://YOUR_SERVER_ADDRESS
APP_ORIGIN=http://YOUR_SERVER_ADDRESS
# HTTPS 入口改为 true；通过宝塔 Nginx 反代访问。
COOKIE_SECURE=false
TRUST_PROXY=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
